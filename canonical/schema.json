{
  "schema_version": 1,
  "crew": {
    "required_frontmatter": ["name", "description", "capabilities", "writes", "source"],
    "optional_frontmatter": ["web-scopes", "read-scopes", "tool-order"],
    "capabilities": ["read", "edit", "bash", "web", "agent"],
    "body": "authoritative-persona-body"
  },
  "orders": {
    "required_frontmatter": ["name", "source", "description", "argument-hint", "allowed-tools", "disable-model-invocation", "arguments", "loop_max", "stages", "invocation", "board"],
    "stage_columns": ["order", "stage", "role", "gate", "max_loops"],
    "stages": "JSON array of stage objects",
    "invocation": "@{{role}}({{named-argument}})",
    "board": ["native", "explicit"],
    "narrative": "authoritative workflow body"
  },
  "project_instructions": {
    "canonical": "AGENTS.md",
    "target_override_allowed": true
  }
}
