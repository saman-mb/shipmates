{
  "kind": "sequence",
  "animation": "reveal",
  "title": "One gate, every tool call — /ship-issue on Codex",
  "actors": ["Agent", "Codex hook", "shipmates gate"],
  "messages": [
    {"from": "Agent", "to": "Codex hook", "label": "git push  (phase: build)"},
    {"from": "Codex hook", "to": "shipmates gate", "label": "state gate --tool 'git push'"},
    {"from": "shipmates gate", "to": "Codex hook", "label": "exit 0 — git push needs 'build'", "return": true},
    {"from": "Codex hook", "to": "Agent", "label": "allow", "return": true},
    {"from": "Agent", "to": "Codex hook", "label": "gh pr merge  (phase: build)"},
    {"from": "Codex hook", "to": "shipmates gate", "label": "state gate --tool 'gh pr merge'"},
    {"from": "shipmates gate", "to": "Codex hook", "label": "exit 1 — merge needs 'deliver'", "return": true},
    {"from": "Codex hook", "to": "Agent", "label": "deny — finish review first", "return": true},
    {"from": "Agent", "to": "Codex hook", "label": "gh pr merge  (phase: deliver)"},
    {"from": "shipmates gate", "to": "Codex hook", "label": "exit 0 — now in 'deliver'", "return": true},
    {"from": "Codex hook", "to": "Agent", "label": "allow — merge runs", "return": true}
  ]
}
