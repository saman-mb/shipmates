{
  "version": 1,
  "harnesses": {
    "claude-code": {
      "agents": true,
      "notes": "Canonical source format. The payload is a byte-for-byte mirror of skills/ and agents/.",
      "agents_notes": "Subagents at `.claude/agents/<name>.md` (Markdown + YAML frontmatter, `tools` allowlist). Verified 2026-08-03: https://code.claude.com/docs/en/skills",
      "effort": true,
      "effort_notes": "Per-agent `effort:` frontmatter key. Shipmates emits the cross-harness `low|medium|high` set; Claude Code's own key accepts up to `max`. Static only — the adapter stamps it; there is no per-spawn override. Verified 2026-08-05."
    },
    "github-copilot": {
      "agents": true,
      "agents_notes": "Custom agents at `.github/agents/<name>.agent.md` \u2014 note the double extension. Markdown + YAML frontmatter; `tools` accepts canonical names (read, search, edit, execute, web, agent); combined frontmatter+body capped at 30,000 chars. Verified 2026-08-03: https://docs.github.com/en/copilot/reference/custom-agents-configuration",
      "effort": false,
      "effort_notes": "No per-agent effort field \u2014 reasoning effort is global/session only (open request copilot-cli#2904). Adapter emits nothing rather than invent a key. Verified 2026-08-05."
    },
    "codex": {
      "agents": true,
      "agents_notes": "Subagents GA March 2026. Global `~/.codex/agents/`, project-scoped `.codex/agents/` checked into the repo. Standalone TOML (name, description, developer_instructions, optional model/model_reasoning_effort/sandbox_mode/mcp_servers/skills.config). No documented per-agent tool allowlist, so least privilege is NOT enforced on this target. Verified 2026-08-03: https://learn.chatgpt.com/docs/agent-configuration/subagents",
      "effort": true,
      "effort_notes": "Per-agent `model_reasoning_effort` TOML key. Verified 2026-08-05."
    },
    "cursor": {
      "agents": false,
      "agents_notes": "Correctly false: the cursor adapter emits skill-only (0 crew), so the flag matches adapter output. The earlier blocker is now STALE \u2014 Cursor 2.4 first-party-documents named subagents at `.cursor/agents/*.md` (cursor.com/docs/skills, changelog 2-4, 2026-01-22), so the frontmatter schema is no longer undocumented. Cursor is therefore a viable crew-bearing target: adopt the documented `.cursor/agents/` format and flip this to true when the adapter actually emits crew (tracked in #34). Verified 2026-08-03.",
      "effort": false,
      "effort_notes": "Cursor folds effort into the model string rather than a standalone key, and is skills-only today (no role emission). Blocked on a cursor subagent emitter (#15/#205); adapter emits nothing. Verified 2026-08-05."
    },
    "antigravity": {
      "agents": true,
      "notes": "Adapter emits both agents and skills under .agents/.",
      "agents_notes": "Workspace agents at `.agents/agents/<name>.md` (`subagent: true`, `mainAgent: false`). Successor to the retired Gemini CLI.",
      "effort": false,
      "effort_notes": "No per-agent effort field in the agent frontmatter schema. Adapter emits nothing rather than invent a key. Verified 2026-08-05."
    },
    "windsurf": {
      "agents": false,
      "agents_notes": "TARGET IDENTITY IN DOUBT. Windsurf became Devin Desktop on 2026-06-02; Cascade was deprecated 2026-07-01 and replaced by Devin Local, which does spawn subagents. `.windsurf/` may address a product that no longer uses that name. Needs its own investigation \u2014 rename, retarget, or remove.",
      "effort": false,
      "effort_notes": "No per-agent effort surface (and skills-only, no role emission). Adapter emits nothing. Verified 2026-08-05."
    },
    "opencode": {
      "agents": true,
      "agents_notes": "Subagents at `.opencode/agents/<name>.md` with `mode: subagent` and a deny-first `permission` map. Verified against opencode's parsing source.",
      "effort": true,
      "effort_notes": "Top-level `reasoningEffort` key (provider passthrough), a sibling of `model`/`temperature` in the agent frontmatter. Doc-verified 2026-08-05: https://opencode.ai/docs/agents/"
    }
  },
