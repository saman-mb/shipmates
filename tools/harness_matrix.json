  "lifecycle_events": {
    "_schema": {
      "note": "Each event maps to a `harnesses` object keyed over every target in shipmates::adapters::targets(). Per-cell keys: `supported` (bool); `channel` (the harness-native event id string when supported, else null); `blocking` (bool when supported — true = can deny/gate, false = observe-only — else null); `notes` (non-empty evidence string, naming the source); `verified` (\"YYYY-MM-DD\" for cells confirmed against the harness's first-party docs, or literal false when unverified); and for `supported:false` also `policy` (\"warn\" — record the gap), matching the `features` convention. There is deliberately no JSON-Schema file: the shape is enforced by tests/integration.rs::test_matrix_lifecycle_events_matrix_is_consistent plus this note. Only the PreToolUse row is cross-checked against src/adapters/render.rs::emit_hook_shim (the only event with a real emission today); the other events have no adapter emission yet (epic #113) and record capability, not shipped behaviour."
    },
    "PreToolUse": {
      "harnesses": {
        "claude-code": {
          "supported": true,
          "channel": "PreToolUse",
          "blocking": true,
          "notes": "claude-code `settings.json` `hooks.PreToolUse`; blocking deny channel the FSM gate shim (enforcement/hooks/claude-code/fsm-gate.sh) targets. Verified 2026-08-06.",
          "verified": "2026-08-06"
        },
        "github-copilot": {
          "supported": true,
          "channel": "preToolUse",
          "blocking": true,
          "notes": "Copilot `.github/hooks/*.json` or `~/.copilot/hooks/`; blocking pre-tool hook (enforcement/hooks/github-copilot/fsm-gate.sh). Verified 2026-08-06.",
          "verified": "2026-08-06"
        },
        "codex": {
          "supported": true,
          "channel": "PreToolUse",
          "blocking": true,
          "notes": "Codex `hooks.json` / `config.toml [hooks]` at `~/.codex/` or repo `.codex/` (framework immature — async hooks 'not yet supported'). Blocking (enforcement/hooks/codex/fsm-gate.sh). Verified 2026-08-06.",
          "verified": "2026-08-06"
        },
        "cursor": {
          "supported": true,
          "channel": "beforeShellExecution",
          "blocking": true,
          "notes": "Cursor `.cursor/hooks.json` (1.7+); shell-only blocking hook (enforcement/hooks/cursor/fsm-gate.sh). Verified 2026-08-06.",
          "verified": "2026-08-06"
        },
        "antigravity": {
          "supported": true,
          "channel": "PreToolUse",
          "blocking": true,
          "notes": "Antigravity `hooks.json` in `.agents/` / `~/.gemini/config/` (only 5 hooks total); blocking (enforcement/hooks/antigravity/fsm-gate.sh). Verified 2026-08-06.",
          "verified": "2026-08-06"
        },
        "windsurf": {
          "supported": true,
          "channel": "pre_run_command",
          "blocking": true,
          "notes": "Windsurf/Devin `hooks.json` merged system/user (`~/.codeium/windsurf/`) / workspace (`.windsurf/`); shell-only exit-2 block (enforcement/hooks/windsurf/fsm-gate.sh); docs now Devin-hosted. Verified 2026-08-06.",
          "verified": "2026-08-06"
        },
        "opencode": {
          "supported": true,
          "channel": "tool.execute.before",
          "blocking": true,
          "notes": "opencode plugin module export; the FSM gate denies by throwing from a `tool.execute.before` plugin (enforcement/hooks/opencode/fsm-gate.ts). Verified 2026-08-06.",
          "verified": "2026-08-06"
        }
      }
    },
    "SessionStart": {
      "harnesses": {
        "claude-code": {
          "supported": true,
          "channel": "SessionStart",
          "blocking": false,
          "notes": "claude-code `settings.json` `hooks.SessionStart`; observe-only. Verified 2026-08-06.",
          "verified": "2026-08-06"
        },
        "github-copilot": {
          "supported": true,
          "channel": "sessionStart",
          "blocking": false,
          "notes": "Copilot `.github/hooks/*.json` / `~/.copilot/hooks/`; observe-only. Verified 2026-08-06.",
