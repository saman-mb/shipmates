        "github-copilot": {
          "supported": false,
          "policy": "drop",
          "reason": "Shipped as skills carrying only the standard's name/description pair. The harness has no user-invoked-only equivalent, so the model can start one unprompted; the caveat is documented in Scope & honesty."
        },
        "codex": {
          "supported": false,
          "policy": "drop",
          "reason": "Shipped as skills carrying only the standard's name/description pair. The harness has no user-invoked-only equivalent, so the model can start one unprompted; the caveat is documented in Scope & honesty."
        },
        "cursor": {
          "supported": false,
          "policy": "drop",
          "reason": "Shipped as skills carrying only the standard's name/description pair. The harness has no user-invoked-only equivalent, so the model can start one unprompted; the caveat is documented in Scope & honesty."
        },
        "antigravity": {
          "supported": false,
          "policy": "refuse",
          "reason": "No documented way to keep a skill user-invoked only. The twelve commands create worktrees, push branches and open pull requests, so building without the guard would let the harness auto-start them \u2014 refuse rather than ship that."
        },
        "windsurf": {
          "supported": false,
          "policy": "drop",
          "reason": "Shipped as skills carrying only the standard's name/description pair. The harness has no user-invoked-only equivalent, so the model can start one unprompted; the caveat is documented in Scope & honesty."
        },
        "opencode": {
          "supported": true,
          "reason": "Honoured structurally rather than as a frontmatter key: the payload ships the twelve as `/`-invoked entries under .opencode/commands/, and deliberately does NOT use .opencode/skills/, whose entries opencode's model invokes itself through its native `skill` tool and which has no `disable-model-invocation` equivalent."
        }
      }
