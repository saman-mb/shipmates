    "github-copilot": {
      "notes": "Copilot CLI discovers skills under `.github/skills/` (project) or `~/.copilot/skills` (personal); a repo-scoped install writes the project tree. Copilot ships no subagents, so the adapter emits the crew as twelve skills and ignores `roles`.",
      "agent_path": ".github/agents/{name}.md",
      "skill_path": ".github/skills/{name}/SKILL.md",
      "project_instructions": "AGENTS.md",
