{
  "schema_version": 1,
  "capabilities": ["read", "edit", "bash", "web", "agent"],
  "harnesses": {
    "claude-code": {
      "agent_path": ".claude/agents/{name}.md",
      "skill_path": ".claude/skills/{name}/SKILL.md",
      "project_instructions": "CLAUDE.md",
      "permission_model": "allowlist",
      "scopes": {
        "read": "Read",
        "search": "Grep",
        "glob": "Glob",
        "write": "Write",
        "edit": "Edit",
        "bash": "Bash",
        "web-search": "WebSearch",
        "web-fetch": "WebFetch",
        "agent": "Agent"
      },
      "tools": {
        "read": ["Read", "Grep", "Glob"],
        "edit": ["Write", "Edit"],
        "bash": "Bash",
        "web": {
          "search": "WebSearch",
          "fetch": "WebFetch"
        },
        "agent": "Agent"
      }
    },
    "opencode": {
      "notes": "skill_path targets .opencode/commands/ rather than .opencode/skills/ as a safety property, not a preference: opencode skills are model-invoked through its native `skill` tool and have no `disable-model-invocation` equivalent, so shipping twelve worktree-creating, branch-pushing workflows as skills would make them auto-startable. Commands are `/`-invoked only. Subdirectories under .opencode take their plural names.",
      "agent_path": ".opencode/agents/{name}.md",
      "skill_path": ".opencode/commands/{name}.md",
      "project_instructions": "AGENTS.md",
      "permission_model": "permission-map",
      "scopes": {
        "read": "read",
        "search": "grep",
        "glob": "glob",
        "write": "edit",
        "edit": "edit",
        "bash": "bash",
        "web-search": "websearch",
        "web-fetch": "webfetch",
        "agent": "task"
      },
      "tools": {
        "read": ["read", "grep", "glob"],
        "edit": ["edit"],
        "bash": "bash",
        "web": {
          "search": "websearch",
          "fetch": "webfetch"
        },
        "agent": "task"
      }
    },
    "gemini": {
      "notes": "Covers the Gemini CLI and its Antigravity alias; `shipmates install --harness antigravity` writes the same `.gemini/` tree. The CLI reads project instructions from AGENTS.md.",
      "agent_path": ".gemini/agents/{name}.md",
      "skill_path": ".gemini/skills/{name}/SKILL.md",
      "project_instructions": "AGENTS.md",
      "permission_model": "allowlist",
      "scopes": {
        "read": "read_file",
        "search": "grep",
        "glob": "glob",
        "write": "write_file",
        "edit": "edit",
        "bash": "run_in_shell",
        "web-search": "web_search",
        "web-fetch": "web_fetch",
        "agent": "task"
      },
      "tools": {
        "read": ["read_file", "grep", "glob"],
        "edit": ["write_file", "edit"],
        "bash": "run_in_shell",
        "web": {
          "search": "web_search",
          "fetch": "web_fetch"
        },
        "agent": "task"
      }
    },
    "codex": {
      "notes": "Codex CLI ships no subagents, so the adapter emits the crew as twelve skills under `.codex/skills/` and ignores `roles`.",
      "agent_path": ".codex/agents/{name}.md",
      "skill_path": ".codex/skills/{name}/SKILL.md",
      "project_instructions": "AGENTS.md",
      "permission_model": "allowlist",
      "scopes": {
        "read": "read_file",
        "search": "grep",
        "glob": "glob",
        "write": "write_file",
        "edit": "apply_patch",
        "bash": "run_in_shell",
        "web-search": "web_search",
        "web-fetch": "web_fetch",
        "agent": "task"
      },
      "tools": {
        "read": ["read_file", "grep", "glob"],
        "edit": ["write_file", "apply_patch"],
        "bash": "run_in_shell",
        "web": {
          "search": "web_search",
          "fetch": "web_fetch"
        },
        "agent": "task"
      }
    },
    "cursor": {
